__pycache__/
*.pyc
*.pyo
*.pyd

# temporary generated yara rules from auto_analysis runs
tmp*.bin.yar

# runtime artifacts generated by the auto_analysis pipeline
*.yar
debugger_*.py
# ...but never the skill's own wrapper: it was silently excluded from the repo
# by the rule above, so a fresh clone was missing scripts/debugger_bridge.py
!scripts/debugger_bridge.py
result.txt

# ---- 凭据 / 会话数据（严禁入库）----
*cookies*.json
*-aes-key.txt
*.db
sse-dump.txt
captcha_token.txt

# ---- 本地自动化脚本与中间产物 ----
arena-recon/
cdp-*.mjs
hook-sse*.mjs
inject-and-visit.mjs
agent-chat.mjs
start-agent.mjs
sync-memory.mjs

# local utility scripts (not part of skill pack)
scan-leaks.mjs
redact-doc.mjs

# ---- test-run artifacts written next to the scripts ----
# tests/test_smoke.py drives the real CLIs, which write their default output
# into scripts/<module>/. Kept out of the repo so a test run never dirties git.
scripts/*_scan/
scripts/dotnet_analyze/
scripts/auto_analysis/

# ---- runtime clone targets (never vendored) ----
# tools/setup_full.sh clones upstream sources here at install time. Those trees
# are third-party code under their own licenses (e.g. unicornscan is GPL), so
# they must not be committed into this MIT-licensed repository.
tools/scripts/net/

# python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
